table inet event_network {
    set lans { type ifname; elements = { "{{ event_dj_if }}", "{{ event_guest_if }}" } }
    set blocked_v4 { type ipv4_addr; flags interval; auto-merge;
        elements = { {{ (event_blocked_v4 + event_extra_blocked_v4 + [event_performer_net, event_guest_net, event_guest_router_lan, event_vpn_subnet]) | join(', ') }} }
    }
    chain classify {
        type filter hook prerouting priority mangle; policy accept;
        iifname "{{ event_dj_if }}" meta mark set 0x10
        iifname "{{ event_guest_if }}" meta mark set 0x20
    }
    chain input {
        type filter hook input priority 10; policy drop;
        iifname "lo" accept
        iifname @lans meta nfproto ipv6 drop
        # These checks precede established rules, including after firewall reload.
        iifname @lans tcp dport {{ event_sshd_port }} ip saddr != { {{ event_gateway_admin_cidrs | join(', ') }} } drop
        ct state invalid drop
        ct state established,related accept
        iifname { {{ event_mgmt_ifs | map('to_json') | join(', ') }} } ip saddr { {{ event_gateway_admin_cidrs | join(', ') }} } tcp dport {{ event_sshd_port }} accept
        iifname @lans udp dport { 53, 67 } accept
        iifname @lans tcp dport 53 accept
        iifname @lans icmp type echo-request accept
        iifname != @lans udp sport 67 udp dport 68 accept
        meta l4proto icmp accept
        iifname != @lans meta l4proto ipv6-icmp accept
    }
    chain forward {
        type filter hook forward priority 10; policy drop;
        meta nfproto ipv6 drop
        ct state invalid drop
        # Block management destinations even when reached through the tunnel.
        iifname @lans ip daddr @blocked_v4 counter drop
        iifname "{{ event_dj_if }}" ip saddr != {{ event_performer_net }} drop
        iifname "{{ event_guest_if }}" ip saddr != {{ event_guest_net }} drop
        iifname @lans oifname "{{ event_tun }}" counter accept
        iifname "{{ event_tun }}" oifname @lans ct state established,related counter accept
    }
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        iifname @lans oifname "{{ event_tun }}" masquerade
    }
}
