[Unit]
Description=Normal network firewall
Before=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/event-network/normal-firewall.nft
ExecReload=/usr/sbin/nft -f /etc/event-network/normal-firewall.nft

[Install]
WantedBy=multi-user.target
