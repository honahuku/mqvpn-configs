table inet normal_network {
    chain input {
        type filter hook input priority 10; policy drop;
        iifname "lo" accept
        ct state invalid drop
        ct state established,related accept
        iifname "{{ event_normal_if }}" tcp dport {{ event_normal_ssh_port | default(22) }} accept
        iifname "{{ event_normal_if }}" udp sport 67 udp dport 68 accept
        iifname "{{ event_normal_if }}" icmp type echo-request accept
        meta l4proto icmp accept
        meta nfproto ipv6 drop
    }
    chain forward {
        type filter hook forward priority 10; policy drop;
    }
    chain output {
        type filter hook output priority 10; policy accept;
    }
}
